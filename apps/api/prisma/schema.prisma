datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  RECRUITER
  MANAGER
  EMPLOYEE
  CANDIDATE
}

enum EmployeeStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum CandidateStage {
  SOURCED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskStatus {
  PENDING
  SUBMITTED
  COMPLETED
  REJECTED
}

enum DocStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  AUDITED
  APPROVED
  PROCESSED
}

enum ExpenseStatus {
  SUBMITTED
  AUDITING
  APPROVED
  REJECTED
  REIMBURSED
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  plan        String   @default("ENTERPRISE")
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  refreshTokens     RefreshToken[]
  employees         Employee[]
  departments       Department[]
  orgEdges          OrgEdge[]
  jobOpenings       JobOpening[]
  candidates        Candidate[]
  applications      Application[]
  interviews        Interview[]
  onboardingPlans   OnboardingPlan[]
  onboardingTasks   OnboardingTask[]
  documents         Document[]
  attendances       Attendance[]
  leaveRequests     LeaveRequest[]
  payrollRuns       PayrollRun[]
  payslips          Payslip[]
  expenses          Expense[]
  generalLedgers    GeneralLedger[]
  emailTemplates    EmailTemplate[]
  emailLogs         EmailLog[]
  notifications     Notification[]
  aiAuditTrails     AiAuditTrail[]
  agentRuns         AgentRun[]
  apiKeys           ApiKey[]
  webhooks          Webhook[]
  webhookDeliveries WebhookDelivery[]
  customModules     CustomModule[]
  customRecords     CustomRecord[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid())
  tenantId           String
  email              String
  passwordHash       String
  role               Role      @default(EMPLOYEE)
  twoFactorEnabled   Boolean   @default(false)
  twoFactorSecret    String?
  failedLoginAttempts Int      @default(0)
  lockedUntil        DateTime?
  emailVerified      Boolean   @default(false)
  verificationToken  String?
  resetToken         String?
  resetTokenExpiry   DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens      RefreshToken[]
  employee           Employee?
  notifications      Notification[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id               String   @id @default(uuid())
  tenantId         String
  userId           String
  tokenHash        String   @unique
  replacedByToken  String?
  revoked          Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("refresh_tokens")
}

model Department {
  id          String       @id @default(uuid())
  tenantId    String
  name        String
  code        String
  managerId   String?
  budget      Float        @default(0.0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees   Employee[]
  jobOpenings JobOpening[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

model Employee {
  id               String         @id @default(uuid())
  tenantId         String
  userId           String?        @unique
  employeeId       String
  firstName        String
  lastName         String
  email            String
  phone            String?
  jobTitle         String
  departmentId     String?
  managerId        String?
  status           EmployeeStatus @default(ONBOARDING)
  joinDate         DateTime       @default(now())
  salary           Float          @default(0.0)
  currency         String         @default("USD")
  address          String?
  emergencyContact String?
  profilePhotoUrl  String?
  skills           String[]       @default([])
  skillsEmbedding  String?        // stored text/vector representation
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  department       Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager          Employee?      @relation("ManagementChain", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates     Employee[]     @relation("ManagementChain")

  onboardingPlans  OnboardingPlan[]
  documents        Document[]
  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
  payslips         Payslip[]
  expenses         Expense[]
  interviews       Interview[]

  outboundEdges    OrgEdge[]      @relation("OrgEdgeFrom")
  inboundEdges     OrgEdge[]      @relation("OrgEdgeTo")

  @@unique([tenantId, employeeId])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([departmentId])
  @@map("employees")
}

model OrgEdge {
  id               String   @id @default(uuid())
  tenantId         String
  fromEmployeeId   String
  toEmployeeId     String
  relationType     String   @default("COLLABORATES_WITH") // REPORTS_TO, COLLABORATES_WITH, MENTORS
  confidenceScore  Float    @default(1.0)
  notes            String?
  createdAt        DateTime @default(now())

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromEmployee     Employee @relation("OrgEdgeFrom", fields: [fromEmployeeId], references: [id], onDelete: Cascade)
  toEmployee       Employee @relation("OrgEdgeTo", fields: [toEmployeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("org_edges")
}

model JobOpening {
  id           String        @id @default(uuid())
  tenantId     String
  title        String
  departmentId String?
  location     String        @default("Remote")
  type         JobType       @default(FULL_TIME)
  description  String
  requirements String?
  salaryMin    Float?
  salaryMax    Float?
  status       JobStatus     @default(OPEN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  applications Application[]
  interviews   Interview[]

  @@index([tenantId])
  @@map("job_openings")
}

model Candidate {
  id                 String         @id @default(uuid())
  tenantId           String
  firstName          String
  lastName           String
  email              String
  phone              String?
  resumeUrl          String?
  resumeText         String?
  skills             String[]       @default([])
  skillsEmbedding    String?        // Vector embedding representation
  currentCompany     String?
  currentTitle       String?
  experienceYears    Float          @default(0.0)
  expectedSalary     Float?
  stage              CandidateStage @default(SOURCED)
  aiScore            Float?         @default(0.0)
  aiSummary          String?
  interactionHistory Json           @default("[]")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applications       Application[]
  interviews         Interview[]
  documents          Document[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("candidates")
}

model Application {
  id           String         @id @default(uuid())
  tenantId     String
  candidateId  String
  jobOpeningId String
  status       String         @default("ACTIVE")
  stage        CandidateStage @default(APPLIED)
  matchScore   Float?         @default(0.0)
  appliedAt    DateTime       @default(now())
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate    Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOpening   JobOpening     @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("applications")
}

model Interview {
  id              String          @id @default(uuid())
  tenantId        String
  candidateId     String
  jobOpeningId    String
  interviewerId   String?
  title           String
  scheduledAt     DateTime
  durationMinutes Int             @default(45)
  meetUrl         String?
  stage           String          @default("TECHNICAL")
  score           Float?
  feedback        String?
  notes           String?
  status          InterviewStatus @default(SCHEDULED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate       Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOpening      JobOpening      @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  interviewer     Employee?       @relation(fields: [interviewerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("interviews")
}

model OnboardingPlan {
  id           String           @id @default(uuid())
  tenantId     String
  title        String
  departmentId String?
  role         String?
  description  String?
  isTemplate   Boolean          @default(false)
  employeeId   String?
  progress     Float            @default(0.0)
  status       OnboardingStatus @default(PENDING)
  startDate    DateTime?
  dueDate      DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee     Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tasks        OnboardingTask[]

  @@index([tenantId])
  @@map("onboarding_plans")
}

model OnboardingTask {
  id               String     @id @default(uuid())
  tenantId         String
  planId           String
  title            String
  description      String?
  category         String     @default("DOCUMENT") // DOCUMENT, IT_SETUP, TRAINING, HR_FORM, MEET_TEAM
  order            Int        @default(0)
  status           TaskStatus @default(PENDING)
  assignedToRole   String?    @default("EMPLOYEE")
  dueDate          DateTime?
  completedAt      DateTime?
  autoCompletable  Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan             OnboardingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([planId])
  @@map("onboarding_tasks")
}

model Document {
  id                 String     @id @default(uuid())
  tenantId           String
  employeeId         String?
  candidateId        String?
  title              String
  type               String     @default("GENERAL") // ID_PROOF, TAX_FORM, OFFER_LETTER, NDA, CERTIFICATE
  fileUrl            String
  fileSize           Int        @default(0)
  mimeType           String     @default("application/pdf")
  status             DocStatus  @default(PENDING)
  expiryDate         DateTime?
  ocrExtractedData   Json       @default("{}")
  signedAt           DateTime?
  signatureHash      String?
  verifiedBy         String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee           Employee?  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  candidate          Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("documents")
}

model Attendance {
  id             String    @id @default(uuid())
  tenantId       String
  employeeId     String
  date           DateTime  @default(now())
  punchIn        DateTime?
  punchOut       DateTime?
  inLatitude     Float?
  inLongitude    Float?
  outLatitude    Float?
  outLongitude   Float?
  deviceMeta     Json?     @default("{}")
  totalHours     Float?    @default(0.0)
  status         String    @default("PRESENT") // PRESENT, LATE, HALF_DAY, ABSENT
  anomalyFlags   String[]  @default([])
  agentReviewed  Boolean   @default(false)
  reviewNotes    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId, date])
  @@map("attendances")
}

model LeaveRequest {
  id             String      @id @default(uuid())
  tenantId       String
  employeeId     String
  leaveType      String      @default("ANNUAL") // ANNUAL, SICK, CASUAL, PARENTAL, UNPAID
  startDate      DateTime
  endDate        DateTime
  daysCount      Float       @default(1.0)
  reason         String
  status         LeaveStatus @default(PENDING)
  approvedById   String?
  reviewComment  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("leave_requests")
}

model PayrollRun {
  id              String        @id @default(uuid())
  tenantId        String
  month           Int
  year            Int
  status          PayrollStatus @default(DRAFT)
  totalGross      Float         @default(0.0)
  totalDeductions Float         @default(0.0)
  totalNet        Float         @default(0.0)
  auditedByAgent  Boolean       @default(false)
  anomalySummary  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslips        Payslip[]
  generalLedgers  GeneralLedger[]

  @@unique([tenantId, month, year])
  @@index([tenantId])
  @@map("payroll_runs")
}

model Payslip {
  id           String     @id @default(uuid())
  tenantId     String
  payrollRunId String
  employeeId   String
  grossSalary  Float
  allowances   Json       @default("{}")
  deductions   Json       @default("{}")
  netSalary    Float
  pdfUrl       String?
  status       String     @default("GENERATED") // GENERATED, PAID
  paidAt       DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("payslips")
}

model Expense {
  id             String        @id @default(uuid())
  tenantId       String
  employeeId     String
  title          String
  category       String        @default("GENERAL") // TRAVEL, MEALS, SOFTWARE, HARDWARE, TRAINING, OFFICE, OTHER
  amount         Float
  currency       String        @default("USD")
  receiptUrl     String?
  lineItems      Json?         @default("[]")
  status         ExpenseStatus @default(SUBMITTED)
  auditScore     Float?        @default(1.0)
  policyFlag     String?
  auditedByAgent Boolean       @default(false)
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  generalLedgers GeneralLedger[]

  @@index([tenantId])
  @@map("expenses")
}

model GeneralLedger {
  id              String      @id @default(uuid())
  tenantId        String
  expenseId       String?
  payrollRunId    String?
  accountCode     String
  debit           Float       @default(0.0)
  credit          Float       @default(0.0)
  description     String
  transactionDate DateTime    @default(now())
  createdAt       DateTime    @default(now())

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expense         Expense?    @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  payrollRun      PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("general_ledgers")
}

model EmailTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  subject     String
  bodyHtml    String
  variables   String[] @default([])
  category    String   @default("GENERAL")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emailLogs   EmailLog[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("email_templates")
}

model EmailLog {
  id             String         @id @default(uuid())
  tenantId       String
  templateId     String?
  recipientEmail String
  recipientName  String?
  subject        String
  bodyHtml       String
  status         String         @default("SENT") // PENDING, SENT, FAILED, SIMULATED
  errorMessage   String?
  sentAt         DateTime       @default(now())
  openedAt       DateTime?
  meta           Json?          @default("{}")
  createdAt      DateTime       @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template       EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("email_logs")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, ACTION_REQUIRED
  link      String?
  isRead    Boolean  @default(false)
  readAt    DateTime?
  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("notifications")
}

model AiAuditTrail {
  id              String   @id @default(uuid())
  tenantId        String
  agentName       String
  triggerType     String   @default("USER_COMMAND") // USER_COMMAND, EVENT_TRIGGER, SCHEDULED_CRON, API
  promptInput     String
  agentOutput     String
  executionTimeMs Int      @default(0)
  status          String   @default("SUCCESS") // SUCCESS, FAILED, WARNING
  error           String?
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("ai_audit_trails")
}

model AgentRun {
  id          String    @id @default(uuid())
  tenantId    String
  agentId     String
  agentName   String
  status      String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  inputParams Json      @default("{}")
  outputData  Json      @default("{}")
  logs        String[]  @default([])
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?      @default(0)
  createdAt   DateTime  @default(now())

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("agent_runs")
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  keyHash    String    @unique
  prefix     String
  scopes     String[]  @default(["*"])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

model Webhook {
  id          String   @id @default(uuid())
  tenantId    String
  url         String
  secret      String
  events      String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([tenantId])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String   @id @default(uuid())
  tenantId     String
  webhookId    String
  event        String
  payload      Json
  statusCode   Int?
  responseBody String?
  attempt      Int      @default(1)
  error        String?
  deliveredAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("webhook_deliveries")
}

model CustomModule {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  icon        String   @default("Boxes")
  description String?
  schemaSpec  Json     // JSON spec: entity fields, table columns, form layout, chart widgets, permissions
  version     Int      @default(1)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records     CustomRecord[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("custom_modules")
}

model CustomRecord {
  id              String       @id @default(uuid())
  tenantId        String
  moduleId        String
  data            Json         @default("{}")
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customModule    CustomModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([moduleId])
  @@map("custom_records")
}
