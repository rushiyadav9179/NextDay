{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "NextDay",
  "version": "1.0.0",
  "identifier": "com.nextday.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=@nextday/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --workspace=@nextday/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "NextDay - Enterprise HR Suite",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
