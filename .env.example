# Environment
NODE_ENV=development
PORT=4000

# Database & Cache
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
COOKIE_DOMAIN=localhost

# Google Gemini LLM API (Leave empty for deterministic realistic mock mode)
GEMINI_API_KEY=

# SMTP Email Configuration (Leave empty to use simulated console delivery)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NextDay HR <noreply@nextday.work>"

# Client CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:4000
VITE_API_URL=http://localhost:4000
